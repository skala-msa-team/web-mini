# Spring Boot does not auto-load this file.
# Export these values in your shell or IDE run configuration when needed.

SERVER_PORT=8080

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://127.0.0.1:8081
APP_DEMO_USER_HEADER_NAME=X-Demo-User-Id

APP_WEBSOCKET_ENDPOINT=/ws
APP_WEBSOCKET_HEARTBEAT=10000,10000
APP_WEBSOCKET_MESSAGE_SIZE_LIMIT=65536
APP_WEBSOCKET_SEND_BUFFER_SIZE_LIMIT=131072
APP_WEBSOCKET_SEND_TIME_LIMIT=20000

APP_AI_PROVIDER=mock
APP_AI_PROMPT_VERSION=judge-v1
DB_NAME=webmini
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/webmini
DB_USERNAME=webmini
DB_PASSWORD=webmini
