# Browser requests stay on the Vite origin and are proxied to the local Backend.
VITE_API_BASE_URL=/api/v1

# Vite development server. 0.0.0.0 exposes it to devices on the same network.
DEV_SERVER_HOST=0.0.0.0
DEV_SERVER_PORT=5173
DEV_SERVER_STRICT_PORT=true

# Backend targets used only by the Vite development proxy.
BACKEND_HTTP_ORIGIN=http://localhost:8080
BACKEND_WS_ORIGIN=ws://localhost:8080
